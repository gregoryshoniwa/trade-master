# Copy this to .env and fill in real values. Never commit .env.

# ─────────────────────────────────────────────────────────────────
# Deriv
# ─────────────────────────────────────────────────────────────────
# Demo app_id; register your own at api.deriv.com for production
DERIV_APP_ID=1089
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
# Comma-separated list of Deriv symbol codes the gateway subscribes to
# and the TTM service forecasts on. Native Deriv codes (NOT display names):
#   R_75        Volatility 75 Index (1s)
#   1HZ100V     Volatility 100 (1-second variant)
#   frxEURUSD   EUR/USD
#   frxXAUUSD   Gold (XAU/USD)
#   cryBTCUSD   BTC/USD
DERIV_DEFAULT_SYMBOL=R_75,1HZ100V,frxEURUSD,frxXAUUSD,cryBTCUSD
# Leave blank for tick-only (no trading); fill for authorized session
DERIV_API_TOKEN=

# ─────────────────────────────────────────────────────────────────
# Postgres (used by api, agents, mem0)
# ─────────────────────────────────────────────────────────────────
POSTGRES_USER=trademaster
POSTGRES_PASSWORD=dev_change_me
POSTGRES_DB=trademaster
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trademaster:dev_change_me@postgres:5432/trademaster

# ─────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────
# NATS
# ─────────────────────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ─────────────────────────────────────────────────────────────────
# QuestDB
# ─────────────────────────────────────────────────────────────────
QUESTDB_HTTP_URL=http://questdb:9000
QUESTDB_ILP_HOST=questdb
QUESTDB_ILP_PORT=9009

# ─────────────────────────────────────────────────────────────────
# Gateway
# ─────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────
# LLM providers (fill at least one before Phase 1)
# ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Auth (Phase 0 — magic link + WebAuthn)
# ─────────────────────────────────────────────────────────────────
AUTH_SECRET=dev_change_me_to_a_long_random_string
JWT_ISSUER=trademaster-local

# ─────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:18080
