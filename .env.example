# Copy this to .env and fill in real values. Never commit .env.

# ─────────────────────────────────────────────────────────────────
# Deriv
# ─────────────────────────────────────────────────────────────────
# Demo app_id; register your own at api.deriv.com for production
DERIV_APP_ID=1089
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
# Comma-separated list of Deriv symbol codes the gateway subscribes to
# and the TTM service forecasts on. Native Deriv codes (NOT display names):
#   R_75        Volatility 75 Index (1s)
#   1HZ100V     Volatility 100 (1-second variant)
#   frxEURUSD   EUR/USD
#   frxXAUUSD   Gold (XAU/USD)
#   cryBTCUSD   BTC/USD
# Symbols the gateway streams + persists. Agents can be configured for any
# symbol in services/api/app/symbols.py CATALOG; only the ones listed here
# actually have live ticks flowing. A practical broad menu (forex majors,
# commodities, crypto, a couple of indices). Synthetics stay off live
# trading — RNG random walks, no edge.
DERIV_DEFAULT_SYMBOL=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD,frxXAUUSD,frxXAGUSD,cryBTCUSD,cryETHUSD,OTC_SPC,OTC_NDX
# Leave blank for tick-only (no trading); fill for authorized session
DERIV_API_TOKEN=

# ─────────────────────────────────────────────────────────────────
# Postgres (used by api, agents, mem0)
# ─────────────────────────────────────────────────────────────────
POSTGRES_USER=trademaster
POSTGRES_PASSWORD=dev_change_me
POSTGRES_DB=trademaster
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trademaster:dev_change_me@postgres:5432/trademaster

# ─────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────
# NATS
# ─────────────────────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ─────────────────────────────────────────────────────────────────
# QuestDB
# ─────────────────────────────────────────────────────────────────
QUESTDB_HTTP_URL=http://questdb:9000
QUESTDB_ILP_HOST=questdb
QUESTDB_ILP_PORT=9009

# ─────────────────────────────────────────────────────────────────
# Gateway
# ─────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────
# LLM providers (fill at least one before Phase 1)
# ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# OpenRouter unlocks DeepSeek / Llama / Qwen / Mistral / GPT-5 via one API.
# Sign up at https://openrouter.ai and create a key. Models you can use
# show up in the agent config picker.
OPENROUTER_API_KEY=

# vLLM (self-hosted inference, OpenAI-compatible API)
# When you run docker compose --profile with-vllm up, the vllm service
# spins up at http://vllm:8000/v1. Otherwise point this at any
# OpenAI-compatible endpoint — including a remote GPU box's tunnel.
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Web search (per-company gated tool the agents can call)
# ─────────────────────────────────────────────────────────────────
# Tavily is the AI-tuned backend (cleaner snippets, paid past free
# tier). Optional — without it `web_search` falls back to DuckDuckGo
# HTML which is free but noisier. Toggle per-company at /settings.
TAVILY_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Forecasting — hosted TSFM.ai ensemble (Chronos-2 + Moirai-2)
# ─────────────────────────────────────────────────────────────────
# Hosted alternative to the local kronos / ttm services. With this set,
# the tsfm container publishes signals under `tsfm-ensemble` which any
# agent can select as its `forecasting_model`. Without it the tsfm
# container stays idle (status=disabled on /healthz) and the local
# kronos / ttm services keep working.
# https://tsfm.ai — create an account, generate a key under Account → API Keys.
TSFM_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Auth (Phase 0 — magic link + WebAuthn)
# ─────────────────────────────────────────────────────────────────
AUTH_SECRET=dev_change_me_to_a_long_random_string
JWT_ISSUER=trademaster-local

# ─────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:18080
